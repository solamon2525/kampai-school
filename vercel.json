{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "redirects": [
        {
            "source": "/games/math/multiply-rally/:path*",
            "destination": "/games/math/math-rally/:path*",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/|games/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/ping",
            "schedule": "0 3 */3 * *"
        },
        {
            "path": "/api/sync-facebook",
            "schedule": "0 1 * * *"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        },
        {
            "source": "/games/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                }
            ]
        }
    ]
}